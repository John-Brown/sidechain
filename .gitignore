# Force-include paths that match global gitignore patterns (lib/, Packages/)
# macOS case-insensitive FS causes global patterns to block these
!packages/
!packages/**
!apps/web/src/lib/
!apps/web/src/lib/**

# Re-assert ignores for build artifacts inside force-included paths
packages/**/node_modules/
packages/**/dist/
packages/**/.turbo/

# Data (downloaded samples, not tracked)
data/

# Local config
.mcp.json
generated_imgs/

# macOS metadata — must come after the force-include negations above to win
**/.DS_Store
